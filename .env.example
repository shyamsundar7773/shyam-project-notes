# Public Vite frontend variables explicitly exposed by vite.config.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set this in Netlify for production builds; required outside local HTTP.
# Local HTTP can default to the current browser host on port 3001.
VITE_BACKEND_URL=

# Expo authentication uses these public values; never place server secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Expo backend origin. On local web, the current browser host is used
# when omitted; physical devices need a reachable laptop/LAN origin.
EXPO_PUBLIC_API_BASE_URL=
