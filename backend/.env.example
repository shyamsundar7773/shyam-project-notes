# Optional local HTTP port; Render supplies PORT in production.
PORT=

# Supabase project URL and publishable key used by backend token verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private Gemini credential and selected model; keep these backend-only.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=

# Comma-separated exact browser origins allowed by backend CORS.
FRONTEND_ORIGIN=
